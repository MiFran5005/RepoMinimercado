@page
@using Front_Minimercado.Pages.Ventanas
@model VehiculosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Carne</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flPlaca" 
            placeholder="Placa"
            asp-for="@Model.Filtro!.Placa"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Carne</h3>
                
                <label>
                    Código
                </label>
                <input id="nmCodigo"
                    asp-for="@Model.Actual!.Codigo" />
                <br/>

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Placa
                </label>
                <input id="nmPlaca"
                    asp-for="@Model.Actual!.Placa" />
                <br />

                <label>
                    Tipo

                </label>
                <input id="nmTipo"
                    asp-for="@Model.Actual!.Tipo" />
                <br />

            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Codigo,
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Placa
                        @Model.Actual!.Tipo
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Placa</th>
                        <th>Tipo</th>
                       
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Placa</td>
                                <td>@elemento.Tipo</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

