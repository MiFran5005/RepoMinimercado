@page
@using Front_Minimercado.Pages.Ventanas
@model ContratoModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Contrato</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flTipoContrato" 
            placeholder="Tipo de Contrato"
            asp-for="@Model.Filtro!.TipoContrato"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Contrato</h3>
                
                <label>
                    FechaInicio
                </label>
                <input id="nmFechaInicio"
                    asp-for="@Model.Actual!.FechaInicio" />
                <br/>

                <label>
                    FechaFin
                </label>
                <input id="nmFechaFin"
                    asp-for="@Model.Actual!.FechaFin" />
                <br />

                <label>
                    TipoContrato
                </label>
                <input id="nmTipoContrato"
                    asp-for="@Model.Actual!.TipoContrato" />
                <br />

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />

                
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.FechaInicio,
                        @Model.Actual!.FechaFin,
                        @Model.Actual!.TipoContrato
                        @Model.Actual!.Descripcion
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>FechaInicio</th>
                        <th>FechaFin</th>
                        <th>TipoContrato</th>
                        <th>Descripcion</th>
                      
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.FechaInicio</td>
                                <td>@elemento.FechaFin</td>
                                <td>@elemento.TipoContrato</td>
                                <td>@elemento.Descripcion</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

