@page
@using Front_Minimercado.Pages.Ventanas
@model ProductosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Producto</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flNombre" 
            placeholder="Nombre"
            asp-for="@Model.Filtro!.Nombre"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Producto</h3>
                
                <label>
                    Código
                </label>
                <input id="nmCodigo"
                    asp-for="@Model.Actual!.Codigo" />
                <br/>

                <label>
                    Nombre
                </label>
                <input id="nmNombre"
                    asp-for="@Model.Actual!.Nombre" />
                <br />

                <label>
                    Precio
                </label>
                <input id="nmPrecio"
                    asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    IVA
                </label>
                <input id="nmIVA"
                    asp-for="@Model.Actual!.IVA" />
                <br />

                <label>
                    Proveedor
                </label>
                <input id="nmProveedor"
                       asp-for="@Model.Actual!.Proveedor" />
                <br />

                <label>
                    Estante
                </label>
                <input id="nmEstante"
                       asp-for="@Model.Actual!.Estante" />
                <br />
                <label>
                    Inventario
                </label>
                <input id="nmInventario"
                       asp-for="@Model.Actual!.Inventario" />
                <br />
                    <label>
                    Marca
                </label>
                <input id="nmMarca"
                       asp-for="@Model.Actual!.Marca" />
                <br />
                <label>
                    Categoria
                </label>
                <input id="nmCategoria"
                       asp-for="@Model.Actual!.Categoria" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Codigo,
                        @Model.Actual!.Nombre,
                        @Model.Actual!.Precio,
                        @Model.Actual!.IVA,
                        @Model.Actual!.Proveedor,
                        @Model.Actual!.Estante,
                        @Model.Actual!.Inventario,
                        @Model.Actual!.Marca
                        @Model.Actual!.Categoria
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>IVA</th>
                        <th>Proveedor</th>
                        <th>Estante</th>
                        <th>Inventario</th>
                        <th>Marca</th> 
                        <th>Categoria</th> 
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Nombre</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.IVA</td>
                                <td>@elemento.Proveedor</td>
                                <td>@elemento.Estante</td>
                                <td>@elemento.Inventario</td>
                                <td>@elemento.Marca</td>
                                <td>@elemento.Categoria</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

