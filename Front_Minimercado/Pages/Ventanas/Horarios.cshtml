@page
@using Front_Minimercado.Pages.Ventanas
@model HorariosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Horarios</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flTurno" 
            placeholder="Turno"
            asp-for="@Model.Filtro!.Turno"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Horarios</h3>
                
                <label>
                    HoraInicio
                </label>
                <input id="nmHoraInicio"
                    asp-for="@Model.Actual!.HoraInicio" />
                <br/>

                <label>
                    HoraFinal
                </label>
                <input id="nmHoraFinal"
                    asp-for="@Model.Actual!.HoraFinal" />
                <br />

                <label>
                    Dia
                </label>
                <input id="nmDia"
                    asp-for="@Model.Actual!.Dia" />
                <br />

                <label>
                    Turno
                </label>
                <input id="nmTurno"
                    asp-for="@Model.Actual!.Turno" />
                <br />

               
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.HoraInicio,
                        @Model.Actual!.HoraFinal,
                        @Model.Actual!.Dia,
                        @Model.Actual!.Turno
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>HoraInicio</th>
                        <th>HoraFinal</th>
                        <th>Dia</th>
                        <th>Turno</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.HoraInicio</td>
                                <td>@elemento.HoraFinal</td>
                                <td>@elemento.Dia</td>
                                <td>@elemento.Turno</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

