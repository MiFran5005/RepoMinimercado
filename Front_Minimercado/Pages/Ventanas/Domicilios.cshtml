@page
@using Front_Minimercado.Pages.Ventanas
@model DomiciliosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Domicilios</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flEmpleado" 
            placeholder="Empleado"
            asp-for="@Model.Filtro!.Empleado"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Domicilios</h3>
                
                <label>
                    Empleado
                </label>
                <input id="nmEmpleado"
                    asp-for="@Model.Actual!.Empleado" />
                <br/>

                <label>
                    Vehiculo
                </label>
                <input id="nmVehiculo"
                    asp-for="@Model.Actual!.Vehiculo" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                    asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Decripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />

                
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Empleado,
                        @Model.Actual!.Vehiculo,
                        @Model.Actual!.Fecha
                        @Model.Actual!.Descripcion
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Código</th>
                        <th>Vehículo</th>
                        <th>Fecha</th>
                        <th>Descripción</th>
                        
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Vehiculo</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Descripcion</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

