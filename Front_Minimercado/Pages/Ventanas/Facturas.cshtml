@page
@using carniceria_front.Pages.Ventanas
@model CarneModel
@{
    ViewData["Title"] = "Carnicería";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Carne</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flCorte" 
            placeholder="Corte"
            asp-for="@Model.Filtro!.Corte"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Carne</h3>
                
                <label>
                    Código
                </label>
                <input id="nmCodigo"
                    asp-for="@Model.Actual!.Codigo" />
                <br/>

                <label>
                    Corte
                </label>
                <input id="nmCorte"
                    asp-for="@Model.Actual!.Corte" />
                <br />

                <label>
                    Precio
                </label>
                <input id="nmPrecio"
                    asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    FechaVencimiento
                </label>
                <input id="nmFechaVencimiento"
                    asp-for="@Model.Actual!.FechaVencimiento" />
                <br />

                <label>
                    Activo
                </label>
                <input id="nmActivo"
                       asp-for="@Model.Actual!.Activo" />
                <br />

                <label>
                    Observaciones
                </label>
                <input id="nmObservaciones"
                       asp-for="@Model.Actual!.Observaciones" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Codigo,
                        @Model.Actual!.Corte,
                        @Model.Actual!.Precio
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Código</th>
                        <th>Corte</th>
                        <th>Precio</th>
                        <th>FechaVencimiento</th>
                        <th>Activo</th>
                        <th>Observaciones</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Codigo</td>
                                <td>@elemento.Corte</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.FechaVencimiento</td>
                                <td>@elemento.Activo</td>
                                <td>@elemento.Observaciones</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

