@page
@using Front_Minimercado.Pages.Ventanas
@model FacturasModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
      enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Facturas</h1>

        <input type="submit"
               value="Buscar"
               class="btn btn-secondary"
               asp-page-handler="BtBuscar" />
        <input type="submit"
               value="Nuevo"
               class="btn btn-secondary"
               asp-page-handler="BtNuevo" />
        <input type="submit"
               value="Guardar"
               class="btn btn-secondary"
               asp-page-handler="BtGuardar" />
        <input type="submit"
               value="Reporte PDF"
               class="btn btn-secondary"
               asp-page-handler="BtPdf"
               formtarget="_blank" />
        <input id="flTotal"
               placeholder="Total"
               asp-for="@Model.Filtro!.Total" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                   type="hidden"
                   asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Facturas</h3>

                <input type="hidden" asp-for="@Model.Actual!.Cantidad" />
                <input type="hidden" asp-for="@Model.Actual!.Total" />

                <label>
                    Cliente
                </label>
                <select id="nmCliente"
                        asp-for="@Model.Actual!.Cliente"
                        asp-items="@(new SelectList(Model.Clientes, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Metodo de pago
                </label>
                <select id="nmMetodo_Pago"
                        asp-for="@Model.Actual!.Metodo_Pago"
                        asp-items="@(new SelectList(Model.Metodos_Pagos, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Empleado
                </label>
                <select id="nmEmpleado"
                        asp-for="@Model.Actual!.Empleado"
                        asp-items="@(new SelectList(Model.Empleados, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                       type="datetime-local"
                       asp-for="@Model.Actual!.Fecha" />
                <br />

                @if (Model.Actual!.Id == 0)
                {
               <label>
                   Productos seleccionados
               </label>
                <br />
                 @foreach (var p in Model.Productos)
                {
                  var cantidad = (HttpContext.Session.GetString("carrito") ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Count(x => x == p.Id.ToString());
              <span>@p.Nombre x @cantidad - @(p.Precio * cantidad)</span>
                  <br />
                }   
                 <input type="submit"
                  value="Vaciar carrito"
                  class="btn btn-secondary"
                  asp-page-handler="BtVaciar" />
            }
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Total,
                        @Model.Actual!.Fecha
                    </h6>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBuscar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cliente</th>
                        <th>Productos</th>
                        <th>Cantidad</th>
                        <th>Total</th>
                        <th>Metodo de pago</th>
                        <th>Empleado</th>
                        <th>Fecha</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._Cliente?.Nombre</td>
                                <td>@string.Join(", ", elemento.Detalles.Select(d => d._Producto?.Nombre))</td>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Total</td>
                                <td>@elemento._Metodo_Pago?.Nombre</td>
                                <td>@elemento._Empleado?.Nombre</td>
                                <td>@elemento.Fecha</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>