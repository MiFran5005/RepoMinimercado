@page
@using Front_Minimercado.Pages.Ventanas
@model FacturasModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Facturas</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
               value="Guardar"
               class="btn btn-secondary"
               asp-page-handler="BtGuardar" />
        <input type="submit"
               value="Reporte PDF"
               class="btn btn-secondary"
               asp-page-handler="BtPdf"
               formtarget="_blank" />
        <input id="flTotal"
               placeholder="Total"
               asp-for="@Model.Filtro!.Total" />
        <input id="flTotal" 
            placeholder="Total"
            asp-for="@Model.Filtro!.Total"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Facturas</h3>
                
                <label>
                    Cantidad
                </label>
                <input id="nmCantidad"
                    asp-for="@Model.Actual!.Cantidad" />
                <br/>

                <label>
                    Total
                </label>
                <input id="nmTotal"
                    asp-for="@Model.Actual!.Total" />
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                    asp-for="@Model.Actual!.Fecha" />
                <br />

                <label>
                    Empleado
                </label>
                <select id="nmEmpleado"
                    asp-for="@Model.Actual!.Empleado"
                    asp-items="@(new SelectList(Model.Empleados, "Id", "Nombre"))">
                </select>
                <br />

                
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Cantidad,
                        @Model.Actual!.Total,
                        @Model.Actual!.Fecha
                        @Model.Actual!.Empleado
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cantidad</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>Empleado</th>
                        
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Total</td>
                                <td>@elemento.Fecha</td>
                                <td>@elemento._Empleado?.Nombre</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

