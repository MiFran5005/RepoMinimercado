@page
@using Front_Minimercado.Pages.Ventanas
@model DetallesModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Detalles</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flFactura" 
            placeholder="Factura"
            asp-for="@Model.Filtro!.Factura"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalles</h3>
                
                <label>
                    Factura
                </label>
                <select id="nmFactura"
                    asp-for="@Model.Actual!.Factura"
                    asp-items="@(new SelectList(Model.Facturas, "Id", "Cantidad"))">
                </select>
                <br />

                <label>
                    Producto
                </label>
                <select id="nmProducto"
                    asp-for="@Model.Actual!.Producto"
                    asp-items="@(new SelectList(Model.Productos, "Id", "Nombre"))">
                </select>
                <br />
                <label>
                    Cliente
                </label>
                <select id="nmCliente"
                    asp-for="@Model.Actual!.Cliente"
                    asp-items="@(new SelectList(Model.Clientes, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Domicilio
                </label>
                <select id="nmDomicilio"
                    asp-for="@Model.Actual!.Domicilio"
                    asp-items="@(new SelectList(Model.Domicilios, "Id", "Fecha"))">
                </select>
                <br />

               <label>
                    Estado
                </label>
                <select id="nmEstado"
                    asp-for="@Model.Actual!.Estado"
                    asp-items="@(new SelectList(Model.Estados, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Metodo_Pago
                </label>
                <select id="nmMetodo_Pago"
                    asp-for="@Model.Actual!.Metodo_Pago"
                    asp-items="@(new SelectList(Model.Metodos_Pagos, "Id", "Nombre"))">
                </select>
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Factura,
                        @Model.Actual!.Producto,
                        @Model.Actual!.Cliente,
                        @Model.Actual!.Domicilio,
                        @Model.Actual!.Estado,
                        @Model.Actual!.Metodo_Pago
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Factura</th>
                        <th>Producto</th>
                        <th>Cliente</th>
                        <th>Domicilio</th>
                        <th>Estado</th>
                        <th>Metodo_Pago</th>
                      
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Factura</td>
                                <td>@elemento.Producto</td>
                                <td>@elemento.Cliente</td>
                                <td>@elemento.Domicilio</td>
                                <td>@elemento.Estado</td>
                                <td>@elemento.Metodo_Pago</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

