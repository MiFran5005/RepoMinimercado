@page
@using Front_Minimercado.Pages.Ventanas
@model Empleados_CargosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Empleados_Cargos</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flEmpleado" 
            placeholder="Empleado"
            asp-for="@Model.Filtro!.Empleado"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Empleados_Cargos</h3>
                
                <label>
                    Cargo
                </label>
                <select id="nmCargo"
                    asp-for="@Model.Actual!.Cargo"
                    asp-items="@(new SelectList(Model.Cargos, "Id", "TipoEmpleado"))">
                </select>
                <br/>

                <label>
                    Empleado
                </label>
                <select id="nmEmpleado"
                    asp-for="@Model.Actual!.Empleado"
                    asp-items="@(new SelectList(Model.Empleados, "Id", "Nombre"))">
                </select>
                <br />

                <label>
                    Contrato
                </label>
                <select id="nmContrato"
                    asp-for="@Model.Actual!.Contrato"
                    asp-items="@(new SelectList(Model.Contratos, "Id", "TipoContrato"))">
                </select>
                <br />

                <label>
                    FechaAsignacion
                </label>
                <input id="nmFechaAsignacion"
                    asp-for="@Model.Actual!.FechaAsignacion" />
                <br />

                
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Cargo,
                        @Model.Actual!.Empleado,
                        @Model.Actual!.Contrato,
                        @Model.Actual!.FechaAsignacion
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cargo</th>
                        <th>Empleado</th>
                        <th>Contrato</th>
                        <th>FechaAsignacion</th>
                        
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cargo</td>
                                <td>@elemento.Empleado</td>
                                <td>@elemento.Contrato</td>
                                <td>@elemento.FechaAsignacion</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

