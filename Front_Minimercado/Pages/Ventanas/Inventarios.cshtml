@page
@using Front_Minimercado.Pages.Ventanas
@model InventariosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Inventarios</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flCantidad" 
            placeholder="Cantidad"
            asp-for="@Model.Filtro!.Cantidad"/>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Inventarios</h3>
                
                <label>
                    Cantidad
                </label>
                <input id="nmCantidad"
                    asp-for="@Model.Actual!.Cantidad" />
                <br/>

                <label>
                    Actualizacion
                </label>
                <input id="nmActualizacion"
                    asp-for="@Model.Actual!.Actualizacion" />
                <br />

                <label>
                    Minimo
                </label>
                <input id="nmMinimo"
                    asp-for="@Model.Actual!.Minimo" />
                <br />

                <label>
                    Maximo
                </label>
                <input id="nmMaximo"
                    asp-for="@Model.Actual!.Maximo" />
                <br />

                
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.Cantidad,
                        @Model.Actual!.Actualizacion,
                        @Model.Actual!.Minimo,
                        @Model.Actual!.Maximo
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cantidad</th>
                        <th>Actualizacion</th>
                        <th>Minimo</th>
                        <th>Maximo</th>
                        
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Actualizacion</td>
                                <td>@elemento.Minimo</td>
                                <td>@elemento.Maximo</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

