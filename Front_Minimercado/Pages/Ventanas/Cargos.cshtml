@page
@using Front_Minimercado.Pages.Ventanas
@model CargosModel
@{
    ViewData["Title"] = "Minimercado";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Cargos</h1>

        <input type="submit"
            value="Buscar"
            class="btn btn-secondary"
            asp-page-handler="BtBuscar"/>
        <input type="submit"
            value="Nuevo"
            class="btn btn-secondary"
            asp-page-handler="BtNuevo"/>
        <input type="submit"
            value="Guardar"
            class="btn btn-secondary"
            asp-page-handler="BtGuardar"/>
        <input id="flTipoEmpleado"
               placeholder="TipoEmpleado"
               asp-for="@Model.Filtro!.TipoEmpleado" />

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input id="nmId"
                type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Cargos</h3>
                
                <label>
                    Salario
                </label>
                <select id="nmSalario"
                    asp-for="@Model.Actual!.Salario"
                    asp-items="@(new SelectList(Model.Salarios, "Id", "Valor"))">
                </select>
                <br />

                <label>
                    Horario
                </label>
                <select id="nmHorario"
                    asp-for="@Model.Actual!.Horario"
                    asp-items="@(new SelectList(Model.Horarios, "Id", "Turno"))">
                </select>
                <br />

                <label>
                    TipoEmpleado
                </label>
                <input id="nmTipoEmpleado"
                    asp-for="@Model.Actual!.TipoEmpleado" />
                <br/>

                <label>
                    Descripcion
                </label>
                <input id="nmDescripcion"
                    asp-for="@Model.Actual!.Descripcion" />
                <br />
            </div>
        }
        
        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>

                    <h4>
                        ¿Desea borrar la entidad...?
                    </h4>
                    <h6>
                        @Model.Actual!.TipoEmpleado,
                        @Model.Actual!.Salario,
                        @Model.Actual!.Horario,
                        @Model.Actual!.Descripcion
                    </h6>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBuscar" />
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>TipoEmpleado</th>
                        <th>Salario</th>
                        <th>Horario</th>
                        <th>Descripcion</th>

                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.TipoEmpleado</td>
                                <td>@elemento._Salario?.Valor</td>
                                <td>@elemento._Horario?.Turno</td>
                                <td>@elemento.Descripcion</td>
                                <td>
                                    <input type="submit" 
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id" />
                                    <input type="submit" 
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

    </div>
</form>

