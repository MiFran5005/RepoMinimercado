@using Microsoft.AspNetCore.Http
@{
    var rol = Context.Session.GetString("Rol");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Front_Minimercado</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Front_Minimercado.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Front_Minimercado</a>
                @if (rol != null)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                @if (rol != null)
                  {
             <ul class="navbar-nav flex-grow-1">
            <li class="nav-item">
                <a class="nav-link text-dark"
                asp-area=""
                asp-page="/Index">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark"
                asp-area=""
                asp-page="/Ventanas/Facturas">Facturas</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark"
                asp-area=""
                asp-page="/Ventanas/Productos">Productos</a>
            </li>

            @if (rol == "Administrador")
            {
                <li class="nav-item">
                    <a class="nav-link text-dark"
                    asp-area=""
                    asp-page="/Ventanas/Clientes">Clientes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                    asp-area=""
                    asp-page="/Ventanas/Contratos">Contratos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area="" 
                     asp-page="/Ventanas/Empleados">Empleados</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""    
                     asp-page="/Ventanas/Estantes">Estantes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Horarios">Horario</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"   
                     asp-area=""    
                     asp-page="/Ventanas/Inventarios">Inventario</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Marcas">Marcas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Pedidos">Pedidos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Proveedores">Proveedores</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Vehiculos">Vehículos</a>
                </li>
                
                  <li class="nav-item">
                   <a class="nav-link text-dark"
                   asp-area=""
                   asp-page="/Ventanas/Roles">Roles</a>
                   </li>
                    <li class="nav-item">
                    <a class="nav-link text-dark"
                    asp-area=""
                    asp-page="/Ventanas/Permisos">Permisos</a>
                    </li>
                   <li class="nav-item">
                     <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Usuarios">Usuarios</a>
                   </li>
                    <li class="nav-item">
                     <a class="nav-link text-dark"
                     asp-area=""
                     asp-page="/Ventanas/Auditorias">Auditorias</a>
                      </li>
                        <li class="nav-item">
                             <a class="nav-link text-dark"
                            asp-area=""
                             asp-page="/Privacy">Privacy</a>
                         </li>
                    }
                </ul>
               }
                  
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Front_Minimercado - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
